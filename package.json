{
  "name": "pushlab",
  "version": "0.2.2",
  "private": true,
  "description": "基于 Tauri 的 APNs 推送调试工具",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "node scripts/tauri-build.mjs",
    "build:web": "vite build",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml",
    "setup:updater": "node scripts/setup-updater-key.mjs",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
